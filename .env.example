# ⚠️ SECURITY WARNING ⚠️
# This is an example configuration file for development purposes only.
# NEVER use these default credentials in production!
# Always use strong, randomly generated passwords in production environments.

# Database Configuration
POSTGRES_USER=threat_user
POSTGRES_PASSWORD=threat_pass
POSTGRES_DB=threat_tracker

# Application
DATABASE_URL=postgres://threat_user:threat_pass@localhost:5432/threat_tracker
NODE_ENV=development

# Docker Build Target (development | production)
BUILD_TARGET=development

# Threat Intelligence APIs
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# AlienVault OTX API Key (free at https://otx.alienvault.com/api)
OTX_API_KEY=your_otx_api_key_here

# Optional: Authentication token for threat ingestion endpoints
# If set, this token must be provided when calling ingestFromAbuseIPDB or checkAndIngestIp
# with autoIngest=true to prevent unauthorized API usage
# THREAT_INGESTION_SECRET=your_secret_token_here

# =============================================================================
# Auth.js Configuration
# =============================================================================

# Required: Secret for signing JWT tokens. DO NOT use this placeholder in production.
# Generate a strong random value, for example: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Optional: Email address for auto-promotion to ADMIN on first registration
# This should be YOUR email. The first user to register with this email
# will automatically be granted ADMIN role.
INITIAL_ADMIN_EMAIL=admin@example.com

# Required for production behind a reverse proxy/tunnel (Cloudflare, nginx, etc.)
# Set to "true" to trust the host header
# AUTH_TRUST_HOST=true
# =============================================================================
# Production Deployment (Cloudflare Tunnel)
# =============================================================================

# Required for production: Cloudflare Tunnel token
# Get from: https://one.dash.cloudflare.com/ > Zero Trust > Access > Tunnels
# Create a tunnel and copy the token
CLOUDFLARED_TOKEN=your_cloudflared_token_here

# Optional: Disable Next.js dev indicators (floating devtools widget)
# Set to "true" for production deployments
# NEXT_PUBLIC_DISABLE_DEVTOOLS=true
