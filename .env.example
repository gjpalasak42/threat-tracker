# ⚠️ SECURITY WARNING ⚠️
# This is an example configuration file for development purposes only.
# NEVER use these default credentials in production!
# Always use strong, randomly generated passwords in production environments.

# Database Configuration
POSTGRES_USER=threat_user
POSTGRES_PASSWORD=threat_pass
POSTGRES_DB=threat_tracker

# Application
DATABASE_URL=postgres://threat_user:threat_pass@localhost:5432/threat_tracker
NODE_ENV=development

# Docker Build Target (development | production)
BUILD_TARGET=development

# Threat Intelligence APIs
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
